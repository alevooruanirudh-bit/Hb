{
  "name": "hemoscan",
  "private": true,
  "version": "1.0.0",
  "description": "HemoScan — offline, non-invasive hemoglobin estimation and anemia screening (screening tool, not a diagnostic device).",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/setup-assets.mjs",
    "setup-assets": "node scripts/setup-assets.mjs",
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:generate": "python3 scripts/generate_demo_samples.py",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "demo:calibrate": "python3 scripts/generate_demo_samples.py --raw-dir .cache/demo-raw && vite-node scripts/calibrate-demo.ts .cache/demo-raw",
    "parity:fixtures": "python3 scripts/generate_demo_samples.py --raw-dir .cache/demo-raw && vite-node scripts/export-parity-fixtures.ts .cache/demo-raw",
    "icons:android": "python3 scripts/generate_android_icons.py"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^4.1.1",
    "@capacitor/android": "^6.2.0",
    "@capacitor/camera": "^6.1.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@fontsource/noto-sans": "^5.1.0",
    "@fontsource/noto-sans-devanagari": "^5.1.0",
    "@fontsource/noto-sans-telugu": "^5.1.0",
    "@mediapipe/tasks-vision": "0.10.18",
    "@techstark/opencv-js": "4.10.0-release.1",
    "@tensorflow/tfjs": "^4.22.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^11.11.0",
    "i18next": "^23.16.0",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
